{
  "name": "print-archive-helper",
  "version": "1.0.0",
  "description": "Local-only Bambu Lab print archiver: watches the printer over LAN MQTT, copies finished 3MFs over FTPS, serves the Print Archive web app.",
  "main": "src/index.js",
  "type": "commonjs",
  "bin": {
    "print-archive-helper": "src/index.js"
  },
  "scripts": {
    "start": "node src/index.js",
    "mock": "node src/index.js --mock",
    "test": "node --test test/threemf.test.js test/e2e-mock.test.js test/bambu-mqtt.test.js test/bambu-ftps.test.js",
    "build-demo": "node scripts/build-demo.js"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "dependencies": {
    "adm-zip": "^0.6.1",
    "basic-ftp": "^6.2.6",
    "mqtt": "^5.10.0"
  },
  "devDependencies": {
    "aedes": "^0.51.3",
    "ftp-srv": "^4.6.3",
    "selfsigned": "^2.4.1"
  }
}
